# Copy to .env.docker on the Linux server; do not commit real values.
POSTGRES_USER=atlas
POSTGRES_DB=atlas
# Use a random hex password (e.g. openssl rand -hex 24), which is URL-safe.
POSTGRES_PASSWORD=replace_with_random_hex_password

# REQUIRED: base64-encoded 32-byte key. For an existing database, reuse its key!
# Generate only for a NEW database: openssl rand -base64 32
DATA_SOURCE_ENCRYPTION_KEY=replace_with_base64_32_byte_key

HAZE_API_ORIGIN=https://skill.paiwo188.com
# Exact public HTTPS origin, without a path or trailing slash.
WEB_ORIGIN=https://atlas.example.com

# Default: only the host reverse proxy can access this port.
WEB_BIND_IP=127.0.0.1
WEB_PORT=3000
# SQLite files, if used, are mounted read-only under /data/sqlite.
SQLITE_DATA_DIR=./deploy-data/sqlite

# Build-only Prisma binary download source; keep it stable to reuse build cache.
# If the official host is slow, set this to:
# https://registry.npmmirror.com/-/binary/prisma
PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh
