# Local PostgreSQL instance. Set the password only in your untracked .env file.
DATABASE_URL="postgresql://postgres:<PASSWORD>@127.0.0.1:5432/atlas?schema=public"
DATA_SOURCE_ENCRYPTION_KEY="<BASE64_ENCODED_32_BYTE_KEY>"
# Only SQLite files inside this server-side directory may be registered.
SQLITE_DATA_SOURCE_ROOT="D:\\eureka-atlas-data\\sqlite"

# Web server-side API origin. Browser requests use same-origin /api and are
# proxied here, which makes LAN access work without a client-side localhost URL.
API_ORIGIN="http://127.0.0.1:3001"

# Required server-side Haze authentication origin (no /api suffix or code default).
# No shared database or JWT secret needed.
HAZE_API_ORIGIN="https://skill.paiwo188.com"
# Explicit allowed web origins for browser writes and credentialed CORS.
# Add your LAN/public URL when accessing the web from another machine.
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Reserved for later milestones; do not configure these until the related feature exists.
ODPS_ACCESS_KEY=
ODPS_SECRET_KEY=

# 数据查询完整结果读取（Windows 可设为 Python 绝对路径；Linux 默认 python3）
MAXCOMPUTE_PYTHON_BIN=python
