generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataSourceStatus {
  UNTESTED
  ACTIVE
  FAILED
}

enum DataSourceSyncStatus {
  IDLE
  RUNNING
  SUCCEEDED
  PARTIAL_FAILED
  FAILED
}

enum DataSourceType {
  MAXCOMPUTE
  MYSQL
  POSTGRESQL
  SQLSERVER
  ORACLE
  MARIADB
  SQLITE
}

enum StandardDataType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  JSON
  BINARY
  UNKNOWN
}

enum AssetStatus {
  ACTIVE
  DEPRECATED
}

enum QueryExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLING
  CANCELLED
  TIMED_OUT
}

enum AskRunStatus {
  RUNNING
  WAITING_CLARIFICATION
  SUCCEEDED
  FAILED
  CANCELLING
  CANCELLED
  INTERRUPTED
}

enum AskMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum GovernanceTaskStatus {
  PENDING
  PROCESSING
  REVIEWING
  COMPLETED
}

enum AiGenerationStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiGenerationStep {
  SAVING_DRAFT
  PREPARING_CONTEXT
  CALLING_LLM
  VALIDATING_RESULT
  SAVING_SUGGESTIONS
}

enum ColumnSemanticType {
  METRIC
  DIMENSION
  LABEL
  PARTITION
}

enum SemanticCatalogStatus {
  PUBLISHED
  ARCHIVED
}

enum SemanticMetricCatalogType {
  ATOMIC
  DERIVED
  MIXED
}

enum ModelProviderKind {
  BUILTIN
  CUSTOM
}

enum ModelTestStatus {
  UNTESTED
  SUCCEEDED
  FAILED
}

model DataSource {
  id                 String           @id @default(cuid())
  name               String           @unique
  type               DataSourceType   @default(MAXCOMPUTE)
  description        String?
  connectionConfig   Json             @default("{}")
  region             String           @default("")
  endpoint           String           @default("")
  defaultProject     String           @default("")
  accessKeyEncrypted String           @default("")
  secretKeyEncrypted String           @default("")
  usernameEncrypted  String?
  passwordEncrypted  String?
  status             DataSourceStatus @default(UNTESTED)
  syncStatus         DataSourceSyncStatus @default(IDLE)
  syncTotalTables    Int              @default(0)
  syncProcessedTables Int              @default(0)
  syncSyncedTables   Int              @default(0)
  syncSkippedTables  Int              @default(0)
  syncFailedTables   Int              @default(0)
  syncError          String?
  syncStartedAt      DateTime?
  syncFinishedAt     DateTime?
  lastTestedAt       DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  projects           MetaProject[]
  syncSpaces         DataSourceSyncSpace[]

  @@map("data_source")
}

model DataSourceSyncSpace {
  id                  String               @id @default(cuid())
  dataSourceId        String
  catalog             String               @default("")
  schema              String               @default("")
  name                String
  description         String?
  selected            Boolean              @default(false)
  syncStatus          DataSourceSyncStatus @default(IDLE)
  syncTotalTables     Int                  @default(0)
  syncProcessedTables Int                  @default(0)
  syncSyncedTables    Int                  @default(0)
  syncSkippedTables   Int                  @default(0)
  syncFailedTables    Int                  @default(0)
  syncError           String?
  syncStartedAt       DateTime?
  syncFinishedAt      DateTime?
  lastSyncedAt        DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  dataSource          DataSource           @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([dataSourceId, catalog, schema])
  @@index([dataSourceId, selected])
  @@map("data_source_sync_space")
}

model AuthSession {
  id             String   @id
  tokenEncrypted String
  memberNo       String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@map("auth_session")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_setting")
}

enum GovernanceOptionType {
  DATA_DOMAIN
  PERMISSION_RELATION
}

model GovernanceOption {
  id          String               @id @default(cuid())
  type        GovernanceOptionType
  value       String
  description String               @default("")
  updatedBy   String               @default("admin")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([type, value])
  @@index([type])
  @@map("governance_option")
}

model ModelProvider {
  id                  String            @id @default(cuid())
  name                String            @unique
  kind                ModelProviderKind
  builtinId           String?
  protocol            String
  baseUrl             String?
  apiKeyEncrypted     String?
  authMode            String            @default("API_KEY")
  oauthEncrypted      String?
  headers             Json              @default("{}")
  compat              Json              @default("{}")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  models              ModelConfig[]

  @@unique([builtinId, authMode])
  @@map("model_provider")
}

model ModelConfig {
  id                  String        @id @default(cuid())
  providerId          String
  modelId             String
  displayName         String?
  protocol            String
  contextWindow       Int           @default(128000)
  maxTokens           Int           @default(16384)
  reasoning           Boolean       @default(false)
  headers             Json          @default("{}")
  compat              Json          @default("{}")
  cost                Json          @default("{}")
  lastTestStatus      ModelTestStatus @default(UNTESTED)
  lastTestedAt        DateTime?
  lastTestLatencyMs   Int?
  lastTestError       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  provider            ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
  @@index([providerId])
  @@map("model_config")
}

model MetaProject {
  id           String      @id @default(cuid())
  dataSourceId String
  name         String
  catalog      String      @default("")
  schema       String      @default("")
  description  String?
  region       String
  status       AssetStatus @default(ACTIVE)
  lastSyncedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  dataSource   DataSource  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  tables       MetaTable[]

  @@unique([dataSourceId, name])
  @@map("meta_project")
}

model MetaTable {
  id              String      @id @default(cuid())
  metaProjectId   String
  name            String
  type            String
  comment         String?
  sourceUpdatedAt DateTime?
  status          AssetStatus @default(ACTIVE)
  lastSyncedAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  metaProject     MetaProject @relation(fields: [metaProjectId], references: [id], onDelete: Cascade)
  columns         MetaColumn[]
  governanceTasks GovernanceTask[]
  semantic        TableSemantic?
  semanticPackage SemanticPackage?
  semanticMetrics SemanticMetric[]
  queryExecutions QueryExecution[]

  @@unique([metaProjectId, name])
  @@map("meta_table")
}

model MetaColumn {
  id          String      @id @default(cuid())
  metaTableId String
  name        String
  dataType    String
  normalizedType StandardDataType @default(UNKNOWN)
  comment     String?
  ordinal     Int
  isNullable  Boolean?
  defaultValue String?
  isPrimaryKey Boolean @default(false)
  isPartition Boolean     @default(false)
  length      Int?
  precision   Int?
  scale       Int?
  status      AssetStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  metaTable   MetaTable   @relation(fields: [metaTableId], references: [id], onDelete: Cascade)
  aiSuggestions AiColumnSuggestion[]
  semantic      ColumnSemantic?
  permissionForTables TableSemantic[] @relation("TableSemanticPermissionColumn")

  @@unique([metaTableId, name])
  @@map("meta_column")
}

model GovernanceTask {
  id              String               @id @default(cuid())
  metaTableId     String
  selectedColumns Json
  status          GovernanceTaskStatus @default(PENDING)
  createdBy       String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  metaTable       MetaTable            @relation(fields: [metaTableId], references: [id], onDelete: Cascade)
  tableSuggestion AiTableSuggestion?
  columnSuggestions AiColumnSuggestion[]
  metricSuggestions AiMetricSuggestion[]
  review           GovernanceReview?
  publishedTableSemantics  TableSemantic[]  @relation("PublishedTableSemantics")
  publishedColumnSemantics ColumnSemantic[] @relation("PublishedColumnSemantics")
  publishedSemanticMetrics SemanticMetric[] @relation("PublishedSemanticMetrics")
  aiGenerations AiGeneration[]

  @@index([metaTableId])
  @@index([createdAt])
  @@map("governance_task")
}

model AiGeneration {
  id                 String               @id @default(cuid())
  governanceTaskId   String
  status             AiGenerationStatus   @default(RUNNING)
  step               AiGenerationStep     @default(SAVING_DRAFT)
  message            String
  error              String?
  previousTaskStatus GovernanceTaskStatus
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  governanceTask     GovernanceTask       @relation(fields: [governanceTaskId], references: [id], onDelete: Cascade)

  @@index([governanceTaskId, status])
  @@index([startedAt])
  @@map("ai_generation")
}

model AiTableSuggestion {
  id           String @id @default(cuid())
  governanceTaskId String @unique
  dataDomain   String?
  businessName String
  description  String
  grain        String?
  permissionColumnId String?
  permissionRelation String?
  queryConfig   Json   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  governanceTask GovernanceTask @relation(fields: [governanceTaskId], references: [id], onDelete: Cascade)
  @@map("ai_table_suggestion")
}

model AiColumnSuggestion {
  id           String @id @default(cuid())
  governanceTaskId String
  metaColumnId String
  metricName   String
  semanticType String
  aggregation  String?
  unit         String?
  groupable    Boolean @default(false)
  candidateValueQueryable Boolean @default(false)
  labelDescription String?
  confidence   Float
  reason       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  governanceTask GovernanceTask @relation(fields: [governanceTaskId], references: [id], onDelete: Cascade)
  metaColumn MetaColumn @relation(fields: [metaColumnId], references: [id], onDelete: Cascade)
  @@unique([governanceTaskId, metaColumnId])
  @@index([metaColumnId])
  @@map("ai_column_suggestion")
}

model AiMetricSuggestion {
  id               String         @id @default(cuid())
  governanceTaskId String
  name             String
  formula          String
  unit             String?
  dependencies     Json
  confidence       Float
  reason           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  governanceTask   GovernanceTask @relation(fields: [governanceTaskId], references: [id], onDelete: Cascade)

  @@unique([governanceTaskId, name])
  @@index([governanceTaskId])
  @@map("ai_metric_suggestion")
}

model GovernanceReview {
  id               String         @id @default(cuid())
  governanceTaskId String         @unique
  tableDraft       Json
  columnDrafts     Json
  metricDrafts     Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  governanceTask   GovernanceTask @relation(fields: [governanceTaskId], references: [id], onDelete: Cascade)

  @@map("governance_review")
}

model SemanticMetric {
  id                     String         @id @default(cuid())
  metaTableId            String
  sourceGovernanceTaskId String
  name                   String
  formula                String
  unit                   String?
  dependencies           Json
  publishedBy            String
  publishedAt            DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  metaTable              MetaTable      @relation(fields: [metaTableId], references: [id], onDelete: Cascade)
  sourceGovernanceTask   GovernanceTask @relation("PublishedSemanticMetrics", fields: [sourceGovernanceTaskId], references: [id], onDelete: Restrict)
  catalogBindings        SemanticMetricBinding[]

  @@unique([metaTableId, name])
  @@index([sourceGovernanceTaskId])
  @@map("semantic_metric")
}

model TableSemantic {
  id                     String         @id @default(cuid())
  metaTableId            String         @unique
  sourceGovernanceTaskId String
  dataDomain             String?
  businessName           String
  description            String
  grain                  String
  permissionColumnId     String?
  permissionRelation     String?
  queryConfig            Json           @default("{}")
  publishedBy            String
  publishedByName        String?
  publishedAt            DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  metaTable              MetaTable      @relation(fields: [metaTableId], references: [id], onDelete: Cascade)
  permissionColumn       MetaColumn?    @relation("TableSemanticPermissionColumn", fields: [permissionColumnId], references: [id], onDelete: SetNull)
  sourceGovernanceTask   GovernanceTask @relation("PublishedTableSemantics", fields: [sourceGovernanceTaskId], references: [id], onDelete: Restrict)

  @@index([sourceGovernanceTaskId])
  @@index([permissionColumnId])
  @@map("table_semantic")
}

model ColumnSemantic {
  id                     String             @id @default(cuid())
  metaColumnId           String             @unique
  sourceGovernanceTaskId String
  metricName             String
  semanticType           ColumnSemanticType
  aggregation            String?
  unit                   String?
  groupable              Boolean            @default(false)
  candidateValueQueryable Boolean            @default(false)
  labelDescription       String?
  publishedBy            String
  publishedAt            DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  metaColumn             MetaColumn         @relation(fields: [metaColumnId], references: [id], onDelete: Cascade)
  sourceGovernanceTask   GovernanceTask     @relation("PublishedColumnSemantics", fields: [sourceGovernanceTaskId], references: [id], onDelete: Restrict)
  metricCatalogBindings  SemanticMetricBinding[]
  dimensionCatalogBinding SemanticDimensionBinding?

  @@index([sourceGovernanceTaskId])
  @@map("column_semantic")
}

model SemanticMetricCatalog {
  id          String                    @id @default(cuid())
  normalizedName String                  @unique
  name        String
  description String                    @default("")
  type        SemanticMetricCatalogType @default(ATOMIC)
  unit        String?
  aliases     Json                      @default("[]")
  dataSource  String                    @default("")
  editedAt    DateTime?
  category    String?
  owner       String?
  usageNotes  String?
  status      SemanticCatalogStatus     @default(PUBLISHED)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  bindings    SemanticMetricBinding[]

  @@index([status, name])
  @@map("semantic_metric_catalog")
}

model SemanticMetricBinding {
  id                String                @id @default(cuid())
  metricCatalogId   String
  columnSemanticId  String?               @unique
  semanticMetricId  String?               @unique
  createdAt         DateTime              @default(now())
  metricCatalog     SemanticMetricCatalog @relation(fields: [metricCatalogId], references: [id], onDelete: Cascade)
  columnSemantic    ColumnSemantic?       @relation(fields: [columnSemanticId], references: [id], onDelete: Cascade)
  semanticMetric    SemanticMetric?       @relation(fields: [semanticMetricId], references: [id], onDelete: Cascade)

  @@index([metricCatalogId])
  @@map("semantic_metric_binding")
}

model SemanticDimensionCatalog {
  id          String                @id @default(cuid())
  normalizedName String              @unique
  name        String
  description String                @default("")
  aliases     Json                  @default("[]")
  dataSource  String                @default("")
  editedAt    DateTime?
  category    String?
  owner       String?
  usageNotes  String?
  status      SemanticCatalogStatus @default(PUBLISHED)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  bindings    SemanticDimensionBinding[]

  @@index([status, name])
  @@map("semantic_dimension_catalog")
}

model SemanticDimensionBinding {
  id                 String                   @id @default(cuid())
  dimensionCatalogId String
  columnSemanticId   String                   @unique
  createdAt          DateTime                 @default(now())
  dimensionCatalog   SemanticDimensionCatalog @relation(fields: [dimensionCatalogId], references: [id], onDelete: Cascade)
  columnSemantic     ColumnSemantic           @relation(fields: [columnSemanticId], references: [id], onDelete: Cascade)

  @@index([dimensionCatalogId])
  @@map("semantic_dimension_binding")
}

model SemanticPackage {
  id          String    @id @default(cuid())
  metaTableId String    @unique
  content     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  metaTable   MetaTable @relation(fields: [metaTableId], references: [id], onDelete: Cascade)

  @@map("semantic_package")
}

enum QueryExecutionKind {
  SEMANTIC_QUERY
  DATA_QUERY
}

model QueryResultChunk {
  queryExecutionId String
  chunkIndex Int
  rows Json
  execution QueryExecution @relation(fields: [queryExecutionId], references: [id], onDelete: Cascade)

  @@id([queryExecutionId, chunkIndex])
  @@map("query_result_chunk")
}

model QueryExecution {
  ownerMemberNo  String?
  id             String               @id @default(cuid())
  metaTableId    String
  dataSourceId   String
  status         QueryExecutionStatus @default(PENDING)
  remoteInstanceId String?             @unique
  idempotencyKey  String?
  request        Json
  sql            String
  contentVersion String
  snapshotDate   String?
  resultColumns  Json?
  result         Json?
  kind           QueryExecutionKind @default(SEMANTIC_QUERY)
  resultRowCount Int @default(0)
  resolvedDates  Json @default("[]")
  resultChunks   QueryResultChunk[]
  resultBytes    Int                  @default(0)
  truncated      Boolean              @default(false)
  error          String?
  submittedAt    DateTime             @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  expiresAt      DateTime
  metaTable      MetaTable            @relation(fields: [metaTableId], references: [id], onDelete: Cascade)
  askRunLinks    AskRunQuery[]

  @@index([kind, status])
  @@index([status])
  @@unique([ownerMemberNo, idempotencyKey])
  @@index([ownerMemberNo, submittedAt])
  @@index([metaTableId, submittedAt])
  @@map("query_execution")
}

model AskRun {
  id              String       @id @default(cuid())
  askSessionId    String?
  status          AskRunStatus @default(RUNNING)
  idempotencyKey  String
  question        String
  answer          String?
  modelConfigId   String
  modelDisplayName String?
  modelProviderName String?
  thinkingLevel        String   @default("off")
  tableIds        Json
  packageVersions Json         @default("{}")
  clarification   Json?
  error           String?
  clarificationId String?
  nextEventSequence Int        @default(0)
  nextMessageSequence Int      @default(0)
  queryDefinition Json?
  conditionChanges Json?
  loopVersion      Int          @default(0)
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  updatedAt       DateTime     @updatedAt
  messages        AskRunMessage[]
  events          AskRunEvent[]
  queries         AskRunQuery[]
  session         AskSession?  @relation(fields: [askSessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@unique([askSessionId, idempotencyKey])
  @@index([askSessionId, startedAt])
  @@map("ask_run")
}

model AskSession {
  ownerMemberNo        String?
  id                   String   @id @default(cuid())
  title                String
  tableIds             Json     @default("[]")
  modelConfigId        String
  thinkingLevel        String   @default("off")
  configurationVersion Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  runs                 AskRun[]
  savedResults         AskSavedQueryResult[]

  @@index([ownerMemberNo, updatedAt, id])
  @@map("ask_session")
}
model AskRunMessage {
  id        String         @id @default(cuid())
  askRunId  String
  sequence  Int
  role      AskMessageRole
  content   Json
  createdAt DateTime       @default(now())
  askRun    AskRun         @relation(fields: [askRunId], references: [id], onDelete: Cascade)

  @@unique([askRunId, sequence])
  @@map("ask_run_message")
}

model AskRunEvent {
  id        String   @id @default(cuid())
  askRunId  String
  sequence  Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  askRun    AskRun   @relation(fields: [askRunId], references: [id], onDelete: Cascade)

  @@unique([askRunId, sequence])
  @@index([askRunId, sequence])
  @@map("ask_run_event")
}

model AskRunQuery {
  id               String         @id @default(cuid())
  askRunId         String
  queryExecutionId String         @unique
  createdAt        DateTime       @default(now())
  askRun           AskRun         @relation(fields: [askRunId], references: [id], onDelete: Cascade)
  queryExecution   QueryExecution @relation(fields: [queryExecutionId], references: [id], onDelete: Cascade)

  @@index([askRunId])
  @@map("ask_run_query")
}
model AskSavedQueryResult {
  id               String   @id @default(cuid())
  askSessionId     String
  askRunId         String
  queryExecutionId String   @unique
  snapshot         Json
  createdAt        DateTime @default(now())
  askSession       AskSession @relation(fields: [askSessionId], references: [id], onDelete: Cascade)

  @@index([askRunId])
  @@map("ask_saved_query_result")
}
